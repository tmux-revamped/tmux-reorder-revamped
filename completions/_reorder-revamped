#compdef reorder-revamped

_reorder_revamped() {
  local -a commands
  commands=(
    'apply:bind the mouse keys now'
    'list:print every binding apply would make'
    'grab:measure the tabs when a drag starts'
    'slide:move the dragged window while dragging'
    'drop:move the dragged window on release'
    'edge:move the dragged window to an end'
    'swipe:change window or session after a swipe'
    'doctor:check this machine'
    'version:print the version'
    'help:print the help page'
  )

  _arguments \
    '--json[list prints one JSON object]' \
    '--theme[colours of the terminal interface]:theme:(kodougu catppuccin-mocha catppuccin-latte dracula nord gruvbox tokyo-night mono)' \
    '--mode[how a drop moves the window]:value:(insert swap)' \
    '--live[slide the tab while dragging]:value:(on off)' \
    '--edges[bind the status line ends]:value:(on off)' \
    '--timeout[seconds a drag stays valid]:value:' \
    '--swipe[right-button swipe in a pane]:value:(on off)' \
    '1:command:->command'

  if [[ "${state}" == command ]]; then
    _describe 'command' commands
  fi
}

_reorder_revamped "$@"
